  { tag: 'ADA', re: /\b(cardano|ada)\b/i, symbol: 'ADAUSDT' },
  { tag: 'DOGE', re: /\b(dogecoin|doge)\b/i, symbol: 'DOGEUSDT' },
  { tag: 'AVAX', re: /\b(avalanche|avax)\b/i, symbol: 'AVAXUSDT' },
  { tag: 'DOT', re: /\b(polkadot|dot)\b/i, symbol: 'DOTUSDT' },
