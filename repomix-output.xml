          <div className="nacs-cube-face nacs-cube-face--top" />
          <div className="nacs-cube-face nacs-cube-face--bottom" />
        </div>
        <div className="nacs-orbit-dot" />
        <div className="nacs-orbit-dot nacs-orbit-dot--2" />
