.nacs-cube-face--bottom { transform: rotateX(-90deg) translateZ(14px); }

.nacs-cube--nested .nacs-cube-face--front  { transform: translateZ(11px); }
.nacs-cube--nested .nacs-cube-face--back   { transform: rotateY(180deg) translateZ(11px); }
.nacs-cube--nested .nacs-cube-face--right  { transform: rotateY(90deg) translateZ(11px); }
.nacs-cube--nested .nacs-cube-face--left   { transform: rotateY(-90deg) translateZ(11px); }
.nacs-cube--nested .nacs-cube-face--top    { transform: rotateX(90deg) translateZ(11px); }
.nacs-cube--nested .nacs-cube-face--bottom { transform: rotateX(-90deg) translateZ(11px); }

/* Pyramid */
.nacs-pyramid {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 48px;
  height: 48px;
  margin: -24px 0 0 -24px;
  transform-style: preserve-3d;
  animation: nacs-pyramid-spin 5s linear infinite;
}

.nacs-pyramid-face {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 24px solid transparent;
  border-right: 24px solid transparent;
  border-bottom: 40px solid rgba(240, 185, 11, 0.18);
  transform-origin: 50% 100%;
  left: 0;
  top: 4px;
  filter: drop-shadow(0 0 4px rgba(240, 185, 11, 0.25));
}

.nacs-pyramid-face--f { transform: rotateY(0deg) translateZ(14px) rotateX(-22deg); border-bottom-color: rgba(245, 215, 110, 0.35); }
.nacs-pyramid-face--r { transform: rotateY(90deg) translateZ(14px) rotateX(-22deg); border-bottom-color: rgba(201, 148, 0, 0.4); }
.nacs-pyramid-face--b { transform: rotateY(180deg) translateZ(14px) rotateX(-22deg); border-bottom-color: rgba(168, 123, 0, 0.35); }
.nacs-pyramid-face--l { transform: rotateY(-90deg) translateZ(14px) rotateX(-22deg); border-bottom-color: rgba(212, 160, 23, 0.38); }

@keyframes nacs-cube-spin {
  0%   { transform: rotateX(-22deg) rotateY(0deg); }
  50%  { transform: rotateX(28deg) rotateY(180deg); }
  100% { transform: rotateX(-22deg) rotateY(360deg); }
}

@keyframes nacs-pyramid-spin {
  from { transform: rotateX(-12deg) rotateY(0deg); }
  to   { transform: rotateX(-12deg) rotateY(360deg); }
}

@keyframes nacs-orbit-spin {
  from { transform: rotateZ(0deg); }
  to   { transform: rotateZ(360deg); }
}

.nacs-progress-indeterminate {
  width: 40%;
  animation: nacs-progress-slide 1.4s ease-in-out infinite;
}

@keyframes nacs-progress-slide {
  0%   { transform: translateX(-120%); }
  100% { transform: translateX(320%); }
}

.nacs-app-header {
  background: linear-gradient(180deg, #141a22 0%, #12161c 100%);
  border-bottom: 1px solid #1e2329;
  box-shadow: 0 1px 0 rgba(240, 185, 11, 0.05);
}

.nacs-guest-card {
  background: linear-gradient(165deg, #12161c 0%, #0d1117 100%);
  border: 1px solid #1e2329;
  box-shadow:
    0 0 0 1px rgba(240, 185, 11, 0.05),
    0 24px 48px rgba(0, 0, 0, 0.45);
}
