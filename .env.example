# Optional – only if API is on another origin than the Pages site.
# After Cloudflare Pages deploy, leave empty: same-origin /api/workspace works.
# VITE_WORKSPACE_API=https://your-pages-project.pages.dev

# Observability (optional)
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Feature flags (build-time)
# VITE_ALLOW_GUEST=0
# VITE_LIVE_TRADING=1
# VITE_AI_ANALYZE=1
# VITE_NEWS_PANEL=1
# VITE_OPS_PANEL=1
