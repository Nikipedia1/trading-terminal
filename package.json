{
  "name": "nacs-lab-terminal",
  "private": true,
  "version": "0.2.0",
  "description": "NACS Lab Terminal — Blockchain Trading Terminal (web + desktop)",
  "author": "NACS Lab",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron:dev": "electron .",
    "desktop": "npx concurrently -k \"npm run dev\" \"npx wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "npm run build:desktop && electron-builder",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "cf:kv:create": "wrangler kv namespace create WORKSPACE_KV",
    "cf:kv:create:preview": "wrangler kv namespace create WORKSPACE_KV --preview",
    "cf:pages:dev": "npm run build && wrangler pages dev dist --kv WORKSPACE_KV",
    "deploy:cf": "npm run build && wrangler pages deploy dist",
    "deploy:cf:preview": "npm run build && wrangler pages deploy dist --branch preview"
  },
  "build": {
    "appId": "lab.nacs.terminal",
    "productName": "NACS Lab Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "html2canvas": "^1.4.1",
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4",
    "react-resizable": "^3.2.0",
    "three": "^0.170.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1",
    "wrangler": "^3.91.0"
  }
}
